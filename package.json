{
  "name": "cmd-deck",
  "description": "Always-on-top command deck for running terminal commands in the background.",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.12",
  "repository": "https://github.com/taylorivanoff/cmd-deck",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "bump": "node scripts/bump-version.js",
    "release": "electron-builder --publish=never"
  },
  "build": {
    "appId": "io.github.taylorivanoff.cmd-deck",
    "productName": "CmdDeck",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "afterPack": "./scripts/after-pack.js",
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://standupmate.com/updates/cmd-deck"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-tray-base": "file:../electron-tray-base",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3"
  }
}
