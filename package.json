{
  "name": "cmd-deck",
  "description": "Always-on-top command deck for running terminal commands in the background.",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.1",
  "repository": "https://github.com/taylorivanoff/cmd-deck",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "release": "electron-builder --publish=never"
  },
  "build": {
    "appId": "io.github.taylorivanoff.cmd-deck",
    "productName": "CmdDeck",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/taylorivanoff/cmd-deck/releases/latest/download"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
