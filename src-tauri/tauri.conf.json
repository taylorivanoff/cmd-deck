{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CmdDeck",
  "version": "1.0.17",
  "identifier": "io.github.taylorivanoff.cmd-deck",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CmdDeck",
        "url": "index.html",
        "width": 335,
        "height": 140,
        "minWidth": 335,
        "minHeight": 140,
        "resizable": true,
        "maximizable": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer.nsi",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjMzMEMzREEzQjJBMzIKUldReUtqdmF3ekR6d2taaHVETjd3MFA4SFpJMHRieG1WRG5sZHU5aWsrSkJXUFRJSTk4VlFoanIK",
      "endpoints": [
        "https://github.com/taylorivanoff/cmd-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
